#tests that Ctrl-C exits program, returning to it's previous program
# The timeout below governs every "expect" block in this script. It was 5 seconds, which is not enough
# on a slow system: the block that has been seen to time out is the one waiting for the "YDB>" prompt
# after Ctrl+C is sent to GDE invoked from inside a YDB direct mode session, on a build carrying both
# ASAN and code coverage. 60 is the value 9d7c3905 used for the same class of failure in
# expect/maskpass_term, and a437d5b1 before it in encryption/exp_test.
set timeout 60
spawn /usr/local/bin/tcsh -f
source $::env(gtm_tst)/com/expectinit.exp
#intended to enter the GDE interface
puts "\n#entering GDE from shell"
send "$::env(gtm_dist)/mumps -run ^GDE\r"
expect "GDE>"
# Send Ctrl-C
puts "\n#sending Ctrl+C"
send -- "\003"
#we expect to drop back to the shell
puts "#checking that program exited"
expect "SHELL"
#next check CTRL+c from YDB
puts "\n#entering YDB"
send "$::env(gtm_dist)/mumps -direct\r"
expect "YDB>"
#go in from YDB
puts "\n#entering GDE from YDB"
send "DO ^GDE\r"
expect "GDE>"
#sent CTRL+c
puts "\n#sending Ctrl+C"
send -- "\003"
expect "YDB>"
#exiting form YDB
puts "\n#exiting YDB with Ctrl+D"
send -- "\004"
expect "SHELL"
